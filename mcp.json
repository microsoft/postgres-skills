{
  "$schema": "https://json.schemastore.org/mcp.json",
  "description": "PostgreSQL MCP Server for AI coding agents. Uses pgsql-tools CLI from github.com/microsoft/pgsql-tools.",
  "servers": {
    "pgsql-tools": {
      "type": "stdio",
      "command": "node",
      "args": ["run_mcp.js"],
      "env": {
        "PGSQL_TOOLS_QUERY_TIMEOUT_MS": "540000"
      },
      "metadata": {
        "source_repo": "https://github.com/microsoft/pgsql-tools",
        "release": "cli-v0.0.1-dev.5",
        "tools": [
          "list_databases",
          "list_tables",
          "execute_read_query",
          "insert_update_records",
          "create_table",
          "drop_table",
          "list_server_configuration",
          "get_server_parameter"
        ],
        "auth_options": [
          "PostgreSQL password — set PGPASSWORD",
          "Microsoft Entra (Azure) — set AZURE_USE_AAD=true"
        ]
      }
    }
  }
}
